{
  "builds": [
    {
      "src": "vercel-build.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "redirects": [
    {
      "source": "/team/:slug*",
      "destination": "/en/team/:slug*",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/en/team",
      "permanent": true
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
